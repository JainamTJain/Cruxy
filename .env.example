# Crux / Cruxy — environment template (empty values only)
# Copy to .env.local for local/dev. Never commit real secrets.

# Supabase (required for production; leave empty to use sample-data path)
# Supabase now issues new keys: put the SECRET key (sb_secret_...) in SUPABASE_SERVICE_ROLE_KEY
# and the PUBLISHABLE key (sb_publishable_...) in NEXT_PUBLIC_SUPABASE_ANON_KEY. See docs/research/apis.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Drive (Track 1+; service account preferred)
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_ROOT_FOLDER_ID=
# Or OAuth (alternative):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transcription
ASSEMBLYAI_API_KEY=

# AI gateway (Vercel AI Gateway only; no OpenRouter or provider SDKs)
AI_GATEWAY_API_KEY=

# Optional literature APIs (Wave 7 research). Most providers work without keys.
# Unpaywall needs an email; falls back to TECH_ADMIN_EMAIL.
UNPAYWALL_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=

# Email (optional until weekly summary — Resend-compatible)
EMAIL_API_KEY=
EMAIL_FROM=
# Jainam's alert inbox for the 80% spend email (Resend). Falls back to
# people.email for tech_admin when set in the database.
TECH_ADMIN_EMAIL=

# Web push (Wave 9 J). Generate with: npx web-push generate-vapid-keys
# Hide "Turn on alerts" until these exist. Public key is safe for the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address identifying the push sender (often TECH_ADMIN_EMAIL)
VAPID_SUBJECT=

# Auth / security (generate before deploy; hash only for admin starter)
SESSION_SECRET=
PASSCODE_VIEW_KEY=
INITIAL_ADMIN_CODE_HASH=
# Optional: argon2 hash of the shared member starter code.
# If empty, sample-data path seeds a local-only starter (see README).
MEMBER_STARTER_CODE_HASH=
# Argon2id hash of Dr. B's own starter (not the shared member code).
# Bootstrapped as auth_codes kind=starter with person_id = Dr. B.
COACH_STARTER_CODE_HASH=

# Caps
MONTHLY_CAP_USD=30

# Optional: protect /api/cron/* (Vercel cron sends Authorization: Bearer …)
CRON_SECRET=

# Dev: force sample-data store even if Supabase vars exist
# USE_SAMPLE_DATA=1
