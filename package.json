{
  "name": "crux",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "check:track0": "tsx scripts/track0-checks.ts",
    "check:track1": "tsx scripts/track1-checks.ts",
    "check:track2": "tsx scripts/track2-checks.ts",
    "check:track3": "tsx scripts/track3-checks.ts",
    "check:track4": "NODE_OPTIONS='--require ./scripts/preload-server-only.cjs' tsx scripts/track4-checks.ts",
    "check:track5": "NODE_OPTIONS='--require ./scripts/preload-server-only.cjs' tsx scripts/track5-checks.ts",
    "check:track6": "tsx scripts/track6-checks.ts",
    "dev": "next dev",
    "lint": "eslint",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed:content": "tsx scripts/seed-content.ts",
    "seed:quality": "tsx scripts/seed-quality.ts",
    "shots": "node scripts/shots.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:access": "tsx scripts/check-access-glossary.ts",
    "smoke:supabase": "node --require ./scripts/preload-server-only.cjs ./node_modules/tsx/dist/cli.mjs scripts/supabase-smoke.ts",
    "smoke:practice": "NODE_OPTIONS='--require ./scripts/preload-server-only.cjs' tsx scripts/smoke-practice-round.ts",
    "smoke:case-roles": "NODE_OPTIONS='--require ./scripts/preload-server-only.cjs' tsx scripts/smoke-case-roles.ts",
    "smoke:socratic-outcomes": "NODE_OPTIONS='--require ./scripts/preload-server-only.cjs' tsx scripts/smoke-socratic-outcomes.ts",
    "check:supabase-wired": "tsx scripts/check-supabase-wired.ts",
    "test:cruxy": "node scripts/with-server-only-stub.cjs ./node_modules/tsx/dist/cli.mjs scripts/test-cruxy.ts",
    "check:cruxy-act": "NODE_OPTIONS='--require ./scripts/preload-server-only.cjs' tsx scripts/cruxy-act-checks.ts",
    "test:voiceprint": "NODE_OPTIONS='--require ./scripts/preload-server-only.cjs' tsx scripts/voiceprint-accuracy.ts",
    "download:voiceprint-model": "node scripts/download-voiceprint-model.mjs",
    "check:critique": "NODE_OPTIONS='--require ./scripts/preload-server-only.cjs' tsx scripts/critique-engine-checks.ts",
    "check:revision": "NODE_OPTIONS='--require ./scripts/preload-server-only.cjs' tsx scripts/check-revision-robustness.ts",
    "check:roadmap-extra": "NODE_OPTIONS='--require ./scripts/preload-server-only.cjs' tsx scripts/roadmap-extra-checks.ts",
    "check:mastery-map": "NODE_OPTIONS='--require ./scripts/preload-server-only.cjs' tsx scripts/mastery-map-checks.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "ai": "^7.0.179",
    "argon2": "^0.45.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "googleapis": "^190.0.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.77.0",
    "mammoth": "^1.13.0",
    "next": "15.5.29",
    "onnxruntime-node": "^1.20.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-swipeable": "^7.0.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "ts-fsrs": "^5.4.2",
    "unpdf": "^1.9.1",
    "uuid": "^14.0.3",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/argon2": "^0.14.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "axe-core": "^4.10.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "playwright": "^1.65.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
