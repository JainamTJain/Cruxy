    {
      "path": "/api/cron/drive-sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/research",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/weekly-summary",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/weekly-review",
      "schedule": "0 3 * * 1"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "wsA": false,
      "merge-*": false
    }
  }
}
